{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \".codex/hooks/wix_comment_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \".codex/hooks/changelog_lockstep_reminder.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
