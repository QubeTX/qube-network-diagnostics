<!--
  The "cargo wix" subcommand provides a variety of predefined variables available
  for customization of this template. The values for each variable are set at
  installer creation time. The following variables are available:

  TargetTriple      = The rustc target triple name.
  TargetEnv         = The rustc target environment. This is typically either
                      "msvc" or "gnu" depending on the toolchain downloaded and
                      installed.
  TargetVendor      = The rustc target vendor. This is typically "pc", but Rust
                      does support other vendors, like "uwp".
  CargoTargetBinDir = The complete path to the directory containing the
                      binaries (exes) to include. The default would be
                      "target\release\". If an explicit rustc target triple is
                      used, i.e. cross-compiling, then the default path would
                      be "target\<CARGO_TARGET>\<CARGO_PROFILE>",
                      where "<CARGO_TARGET>" is replaced with the "CargoTarget"
                      variable value and "<CARGO_PROFILE>" is replaced with the
                      value from the "CargoProfile" variable. This can also
                      be overridden manually with the "target-bin-dir" flag.
  CargoTargetDir    = The path to the directory for the build artifacts, i.e.
                      "target".
  CargoProfile      = The cargo profile used to build the binaries
                      (usually "debug" or "release").
  Version           = The version for the installer. The default is the
                      "Major.Minor.Fix" semantic versioning number of the Rust
                      package.
-->

<!--
  Please do not remove these pre-processor If-Else blocks. These are used with
  the `cargo wix` subcommand to automatically determine the installation
  destination for 32-bit versus 64-bit installers. Removal of these lines will
  cause installation errors.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='nd300'
        UpgradeCode='7208E6EA-ABAE-4AF6-A69C-7C7E4DA3DDF5'
        Manufacturer='Emmett S'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Cross-platform network diagnostic tool'
            Manufacturer='Emmett S'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallExecute'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <!-- Windows Installer cannot major-upgrade across per-user/per-machine
             contexts. The preflight takeover helper therefore refuses an
             opposite-scope registered owner before InstallInitialize instead
             of authoring a cross-context Upgrade row that cannot be honored. -->

        <!-- The package retires a running canonical binary through MoveFiles before
             InstallFiles. Keep Restart Manager from terminating the updater before
             that transactional rename can release the canonical path. -->
        <Property Id='MSIRESTARTMANAGERCONTROL' Value='Disable'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='nd300 Installation'/>

        <!-- ── Cross-method consolidation (v3.2.0+) ──────────────────────────
             Operator policy: exactly one version/edition installed at a time.
             CLEANCARGO removes a shadowing older `cargo install` copy in
             ~\.cargo\bin; CLEANOTHEREDITION removes the other Windows edition
             (here, Corporate perUser). BOTH default to 1 so a SILENT install
             (`msiexec /passive`, used by the self-updater) ALSO consolidates and
             the interactive checkboxes are pre-checked. The self-update
             invocation in src/actions/update.rs::try_msi_install does NOT pass
             these properties, so the defaults (1) stand on a silent update.

             The deletion LOGIC lives in the binary (`nd300 migrate-cleanup`),
             run as the two deferred, IMPERSONATED, best-effort CAs below. It only
             ever removes nd300.exe/speedqx.exe, never cargo/rustup, never the
             .cargo\bin PATH entry, never the running install, and always exits 0,
             and the CAs use Return='ignore' so cleanup can NEVER abort the
             install. Secured=public ("UPPERCASE") so the values survive the
             InstallExecuteSequence (and can be set from the silent command line). -->
        <Property Id='CLEANCARGO' Value='1' Secure='yes'/>
        <Property Id='CLEANOTHEREDITION' Value='1' Secure='yes'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='nd300'>
                    
                    <!--
                      Enabling the license sidecar file in the installer is a four step process:

                      1. Uncomment the `Component` tag and its contents.
                      2. Change the value for the `Source` attribute in the `File` tag to a path
                         to the file that should be included as the license sidecar file. The path
                         can, and probably should be, relative to this file.
                      3. Change the value for the `Name` attribute in the `File` tag to the
                         desired name for the file when it is installed alongside the `bin` folder
                         in the installation directory. This can be omitted if the desired name is
                         the same as the file name.
                      4. Uncomment the `ComponentRef` tag with the Id attribute value of "License"
                         further down in this file.
                    -->
                    <!--
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile' Name='ChangeMe' DiskId='1' Source='C:\Path\To\File' KeyPath='yes'/>
                    </Component>
                    -->

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='D131558E-5659-455C-A5C7-3E7943C3B005' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <!-- MoveFiles is sequenced before RemoveExistingProducts
                                 on a major upgrade. Renaming the running image releases
                                 its canonical filename without terminating the updater. -->
                            <CopyFile
                                Id='RetireRunningNd300'
                                Delete='yes'
                                SourceDirectory='Bin'
                                SourceName='nd300.exe'
                                DestinationDirectory='Bin'
                                DestinationName='nd300.update-old-$(var.Version).exe'/>
                            <CopyFile
                                Id='RetireLegacyRunningNd300'
                                Delete='yes'
                                SourceDirectory='LegacyBin'
                                SourceName='nd300.exe'
                                DestinationDirectory='LegacyBin'
                                DestinationName='nd300.update-old-$(var.Version).exe'/>
                            <File
                                Id='exe0'
                                Name='nd300.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\nd300.exe'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='binary1' Guid='*'>
                            <CopyFile
                                Id='RetireRunningSpeedqx'
                                Delete='yes'
                                SourceDirectory='Bin'
                                SourceName='speedqx.exe'
                                DestinationDirectory='Bin'
                                DestinationName='speedqx.update-old-$(var.Version).exe'/>
                            <CopyFile
                                Id='RetireLegacyRunningSpeedqx'
                                Delete='yes'
                                SourceDirectory='LegacyBin'
                                SourceName='speedqx.exe'
                                DestinationDirectory='LegacyBin'
                                DestinationName='speedqx.update-old-$(var.Version).exe'/>
                            <File
                                Id='exe1'
                                Name='speedqx.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\speedqx.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
                <!-- Pre-v3.1 Global MSI releases used Program Files\nd-300.
                     This must remain a sibling of APPLICATIONFOLDER so LegacyBin
                     resolves to Program Files\nd-300\bin, not a child of the
                     current Program Files\nd300 tree. MoveFiles can then retire
                     a running legacy updater before the shared UpgradeCode
                     removes that older product. -->
                <Directory Id='LegacyApplicationFolder' Name='nd-300'>
                    <Directory Id='LegacyBin' Name='bin'/>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and the license.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            
            <!--
              Uncomment the following `ComponentRef` tag to add the license
              sidecar file to the installer.
            -->
            <!--<ComponentRef Id='License'/>-->

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='binary1'/>
            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!-- ── Cross-method consolidation custom actions (v3.2.0+) ────────────
             Two deferred, IMPERSONATED, best-effort custom actions that run the
             freshly-installed nd300.exe (referenced by FileKey='exe0', so WiX
             resolves the installed path automatically) with `migrate-cleanup`.

             Why FileKey/ExeCommand instead of WixUtilExtension's WixQuietExec:
             cargo-dist drives the Global MSI build via `cargo wix`, which only
             auto-links WixUIExtension (needed for WixUI_FeatureTree). It does NOT
             link WixUtilExtension, so a WixQuietExec-based CA would fail the CI
             link step (unresolved WixCA). A type-18 FileKey CA needs no
             extension, runs the installed exe directly, and is the same behavior.

             Impersonate='yes' is load-bearing: on this perMachine MSI the install
             runs elevated (often as a different/SYSTEM context), but the cleanup
             must resolve the INVOKING USER's ~\.cargo and %LocalAppData%.
             Impersonation runs the CA as the logged-on user, so the user's
             USERPROFILE / LOCALAPPDATA / CARGO_HOME environment is in effect and
             migrate-cleanup finds the right copies without needing the
             user-profile override (the perMachine EXE installer still passes it).

             Return='ignore' => cleanup can NEVER fail the install (advisory).
             Condition `NOT Installed` => runs only on a fresh install or major
             upgrade's install pass, NOT on uninstall (Installed=true, REMOVE=ALL)
             or repair (Installed=true). The CLEANCARGO / CLEANOTHEREDITION
             property gate (default 1) is the consent switch — checked in the UI,
             defaulted-on for silent /passive self-updates. -->
        <CustomAction Id='CleanCargoCopy'
            FileKey='exe0'
            ExeCommand='migrate-cleanup --quiet --install-origin msi-global --cargo-copy'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore'/>
        <Binary Id='InstallTakeoverHelper'
            SourceFile='$(var.CargoTargetBinDir)\nd300.exe'/>
        <CustomAction Id='TakeOverRegisteredChannels'
            BinaryKey='InstallTakeoverHelper'
            ExeCommand='install-takeover --target msi-global --scope all'
            Execute='immediate'
            Return='check'/>
        <CustomAction Id='CleanRetiredUpdate'
            FileKey='exe0'
            ExeCommand='migrate-cleanup --quiet --retired-update'
            Execute='commit'
            Impersonate='no'
            Return='ignore'/>
        <!-- Marker writes are commit actions, after the old product removal, so
             an upgrading product cannot delete the newly selected value. The
             matching uninstall action deletes it only when it still names this
             channel. This avoids authoring one shared registry resource under
             incompatible component GUIDs across the two MSI products. -->
        <CustomAction Id='WriteInstallSourceMarker'
            FileKey='exe0'
            ExeCommand='install-maintenance --action set-marker --origin msi-global'
            Execute='commit'
            Impersonate='yes'
            Return='check'/>
        <CustomAction Id='ClearInstallSourceMarker'
            FileKey='exe0'
            ExeCommand='install-maintenance --action clear-marker --origin msi-global'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore'/>
        <!-- v2.9 and current MSI releases share the historical PATH component
             GUID even though its directory moved. Repair the exact legacy/current
             machine PATH entries after commit rather than rotating the GUID and
             breaking already-shipped v3.1+ ownership. -->
        <!-- Directory properties expand with a trailing backslash. Build these
             paths from their parent properties plus the literal leaf so the
             quoted arguments do not end in \ and escape their closing quote
             under Windows command-line parsing. -->
        <CustomAction Id='RepairLegacyGlobalPath'
            FileKey='exe0'
            ExeCommand='install-maintenance --action repair-global-path --origin msi-global --current-path &quot;[APPLICATIONFOLDER]bin&quot; --legacy-path &quot;[LegacyApplicationFolder]bin&quot;'
            Execute='commit'
            Impersonate='no'
            Return='check'/>
        <?ifdef ND300_ROLLBACK_TEST?>
        <!-- Candidate-matrix-only fault injection. Because this deferred action
             follows InstallFiles in the execution script, its failure proves
             that MoveFiles and both binary replacements roll back together. -->
        <CustomAction Id='ForceRunningImageRollbackTest'
            Directory='TARGETDIR'
            ExeCommand='&quot;[SystemFolder]cmd.exe&quot; /d /c exit 86'
            Execute='deferred'
            Impersonate='no'
            Return='check'/>
        <?endif?>
        <CustomAction Id='CleanOtherEdition'
            FileKey='exe0'
            ExeCommand='migrate-cleanup --quiet --install-origin msi-global --other-edition'
            Execute='deferred'
            Impersonate='yes'
            Return='ignore'/>

        <InstallExecuteSequence>
            <!-- After InstallFiles (so exe0 is on disk), before InstallFinalize. -->
            <Custom Action='TakeOverRegisteredChannels' Before='InstallInitialize'>
                <![CDATA[NOT Installed]]>
            </Custom>
            <?ifdef ND300_ROLLBACK_TEST?>
            <Custom Action='ForceRunningImageRollbackTest' After='InstallFiles'>
                <![CDATA[NOT Installed]]>
            </Custom>
            <?endif?>
            <Custom Action='CleanCargoCopy' Before='InstallFinalize'>
                <![CDATA[NOT Installed AND CLEANCARGO="1"]]>
            </Custom>
            <Custom Action='CleanOtherEdition' After='CleanCargoCopy'>
                <![CDATA[NOT Installed AND CLEANOTHEREDITION="1"]]>
            </Custom>
            <Custom Action='ClearInstallSourceMarker' Before='RemoveFiles'>
                <![CDATA[REMOVE="ALL"]]>
            </Custom>
            <!-- Commit actions are authored inside the execution sequence but run
                 only after InstallFinalize succeeds. Retired images therefore stay
                 available as rollback material for the entire transaction. -->
            <Custom Action='CleanRetiredUpdate' Before='RepairLegacyGlobalPath'>
                <![CDATA[NOT Installed]]>
            </Custom>
            <Custom Action='RepairLegacyGlobalPath' Before='WriteInstallSourceMarker'>
                <![CDATA[NOT Installed]]>
            </Custom>
            <Custom Action='WriteInstallSourceMarker' Before='CleanCargoCopy'>
                <![CDATA[NOT Installed]]>
            </Custom>
        </InstallExecuteSequence>


        <!--
          Uncomment the following `Icon` and `Property` tags to change the product icon.

          The product icon is the graphic that appears in the Add/Remove
          Programs control panel for the application.
        -->
        <!--<Icon Id='ProductICO' SourceFile='wix\Product.ico'/>-->
        <!--<Property Id='ARPPRODUCTICON' Value='ProductICO' />-->

        <Property Id='ARPHELPLINK' Value='https://github.com/QubeTX/qube-network-diagnostics'/>
        
        <UI>
            <UIRef Id='WixUI_FeatureTree'/>

            <!-- ── Cross-method consolidation dialog (v3.2.0+) ────────────────
                 Inserted between WelcomeDlg and CustomizeDlg. Two checkboxes
                 bound to CLEANCARGO / CLEANOTHEREDITION (both default 1, so both
                 render PRE-CHECKED). Unchecking sets the property to 0, which the
                 InstallExecuteSequence condition above reads to skip that CA.
                 A silent install never shows this dialog, so the defaults (1)
                 drive silent consolidation. -->
            <Dialog Id='ConsolidateDlg' Width='370' Height='270' Title='[ProductName] Setup'>
                <Control Id='Title' Type='Text' X='15' Y='6' Width='340' Height='15'
                    Transparent='yes' NoPrefix='yes'>
                    <Text>{\WixUI_Font_Title}Consolidate installs</Text>
                </Control>
                <Control Id='Description' Type='Text' X='25' Y='23' Width='330' Height='30'
                    Transparent='yes' NoPrefix='yes'>
                    <Text>nd300 keeps a single version on your PATH. Choose what to clean up so only one copy/edition remains.</Text>
                </Control>
                <Control Id='BannerLine' Type='Line' X='0' Y='44' Width='370' Height='0'/>

                <Control Id='CleanCargoCheck' Type='CheckBox' X='25' Y='65' Width='320' Height='18'
                    Property='CLEANCARGO' CheckBoxValue='1'
                    Text='Remove an older Cargo-installed copy of nd300 (recommended)'/>
                <Control Id='CleanCargoHint' Type='Text' X='40' Y='84' Width='305' Height='20'
                    Transparent='yes' NoPrefix='yes'>
                    <Text>Deletes a shadowing nd300/speedqx in your .cargo\bin. Cargo and rustup are never touched.</Text>
                </Control>

                <Control Id='CleanOtherCheck' Type='CheckBox' X='25' Y='115' Width='320' Height='18'
                    Property='CLEANOTHEREDITION' CheckBoxValue='1'
                    Text='Remove the other edition if present (recommended)'/>
                <Control Id='CleanOtherHint' Type='Text' X='40' Y='134' Width='305' Height='20'
                    Transparent='yes' NoPrefix='yes'>
                    <Text>Removes the Corporate (per-user) edition so only one edition remains. Skipped automatically if it needs rights you do not have.</Text>
                </Control>

                <Control Id='BottomLine' Type='Line' X='0' Y='234' Width='370' Height='0'/>
                <Control Id='Back' Type='PushButton' X='180' Y='243' Width='56' Height='17'
                    Text='!(loc.WixUIBack)'>
                    <Publish Event='NewDialog' Value='WelcomeDlg'>1</Publish>
                </Control>
                <Control Id='Next' Type='PushButton' X='236' Y='243' Width='56' Height='17'
                    Default='yes' Text='!(loc.WixUINext)'>
                    <Publish Event='NewDialog' Value='CustomizeDlg'>1</Publish>
                </Control>
                <Control Id='Cancel' Type='PushButton' X='304' Y='243' Width='56' Height='17'
                    Cancel='yes' Text='!(loc.WixUICancel)'>
                    <Publish Event='SpawnDialog' Value='CancelDlg'>1</Publish>
                </Control>
            </Dialog>

            <!-- Navigation: Welcome -> Consolidate -> Customize -> ... -->
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='ConsolidateDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='ConsolidateDlg' Order='99'>1</Publish>

        </UI>

        
        <!--
          Enabling the EULA dialog in the installer requires uncommenting
          the following `WixUILicenseRTF` tag and changing the `Value`
          attribute.
        -->
        <!-- <WixVariable Id='WixUILicenseRtf' Value='Relative\Path\to\Eula.rtf'/> -->

        
        <!--
          Uncomment the next `WixVariable` tag to customize the installer's
          Graphical User Interface (GUI) and add a custom banner image across
          the top of each screen. See the WiX Toolset documentation for details
          about customization.

          The banner BMP dimensions are 493 x 58 pixels.
        -->
        <!--<WixVariable Id='WixUIBannerBmp' Value='wix\Banner.bmp'/>-->

        
        <!--
          Uncomment the next `WixVariable` tag to customize the installer's
          Graphical User Interface (GUI) and add a custom image to the first
          dialog, or screen. See the WiX Toolset documentation for details about
          customization.

          The dialog BMP dimensions are 493 x 312 pixels.
        -->
        <!--<WixVariable Id='WixUIDialogBmp' Value='wix\Dialog.bmp'/>-->

    </Product>

</Wix>
